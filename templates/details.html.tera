{% extends "base" %}

{% block content %}
            <div class="controls">
                <span class="title">
                    <a href="/">MARMAK Mirror</a><span class="breadcrumbs">{% if share_path %}{{ macros::breadcrumbs(path=share_path) }}{% else %}{{ macros::breadcrumbs(path=path) }}{% endif %}</span>
                </span>
                <div class="actions">
                    <a href="?download" id="download" download><span>{{ macros::icon(name="favicon", hires=settings.hires) }}{{ strings.download }}{% if downloads %} ({{ downloads }}){% endif %}</span></a>
                </div>
                {%- if not share %}
                <br>
                <a href="./">{{ macros::icon(name="folder", hires=settings.hires) }}./</a>
                {%- endif %}
            </div>
            <p><strong>{{ strings.file_name }}:</strong> {{ filename }}</p>
            <p><strong>{{ strings.file_size }}:</strong> {{ filesize | format_size(use_si=settings.use_si) }}</p>
            {% if additional_props is defined and additional_props | length > 0 -%}
            <p>Additional properties (BETA):</p>
            <ul>
            {% for key, value in additional_props -%}
            <li><strong>{{ key }}:</strong> {{ value }}</li>
            {% endfor -%}
            {% endif -%}
            </ul>
{%- endblock content %}